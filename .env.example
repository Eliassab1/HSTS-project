# HSTS configuration. Copy to `.env` in the repository root and fill in.
#
# Read by the SERVER only, through com.testify.common.EnvConfig, which looks
# for the file in the working directory and up to three parent directories.
# A real environment variable always takes precedence over a value here.
#
# The client never needs any of these - it is told where the server is
# through the login screen's host/port fields.

# -- Database (read by DatabaseConnection) --------------------------------
# All three have defaults, shown here. Override them if your MySQL differs.
HSTS_DB_URL=jdbc:mysql://localhost:3306/hsts_db
HSTS_DB_USER=root
HSTS_DB_PASS=your_mysql_password

# -- Learning bot (read by ClaudeBotEngine via BotEngineFactory) ----------
# OPTIONAL. With no key set the server falls back to LocalRetrievalEngine:
# the bot still answers students from the teacher's uploaded course material
# using local keyword retrieval, but AI question generation is disabled and
# the teacher's generation screen greys itself out with the reason shown.
# ServerMain prints which engine it started on.
ANTHROPIC_API_KEY=

# OPTIONAL. Defaults to claude-haiku-4-5 when unset.
# ANTHROPIC_MODEL=claude-haiku-4-5
